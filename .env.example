# Ключ доступа сообщества (Управление -> Настройки -> Работа с API -> Ключи доступа)
VK_TOKEN=vk1.a.xxxxxxxx
# Строка подтверждения (Работа с API -> Callback API -> "Строка, которую должен вернуть сервер")
VK_CONFIRMATION=abcd1234
# Секретный ключ (там же, поле "Секретный ключ") — придумайте любой
VK_SECRET=my_super_secret
# ID сообщества (число, без минуса)
VK_GROUP_ID=123456789
